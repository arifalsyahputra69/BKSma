##############################################################################
# TEMPLATE .env UNTUK SERVER PRODUKSI (hasil audit keamanan)
#
# Cara pakai: salin file ini menjadi ".env" DI SERVER (bukan di laptop),
# lalu isi nilai yang masih kosong. JANGAN pernah commit file .env asli
# ke Git -- .gitignore sudah mengabaikannya, biarkan tetap begitu.
#
# Perbedaan penting dengan .env lokal saat ini:
#  - APP_ENV=production & APP_DEBUG=false
#      APP_DEBUG=true membuat setiap error menampilkan halaman Whoops berisi
#      potongan kode sumber, isi variabel, DAN seluruh isi .env (termasuk
#      FONNTE_TOKEN, password database) kepada siapa pun yang membuka
#      halaman error itu. Ini kebocoran paling serius kalau sampai terbawa
#      ke server sekolah.
#  - DB_USERNAME bukan "root" & DB_PASSWORD tidak kosong.
#  - SESSION_SECURE_COOKIE=true + SESSION_ENCRYPT=true
#      Aplikasi ini menyimpan data konseling siswa yang sifatnya rahasia;
#      cookie sesi harus hanya dikirim lewat HTTPS.
#  - APP_KEY WAJIB digenerate ulang (php artisan key:generate). Kunci yang
#      dipakai di lokal sudah pernah ada di file yang beredar, jadi tidak
#      boleh dipakai lagi di produksi.
#  - FONNTE_TOKEN wajib di-ROTATE (buat token baru di dashboard Fonnte),
#      karena token yang sekarang sudah tersimpan di file .env lokal.
##############################################################################

APP_NAME="SIM BK Kartika"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-sekolah-anda.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# 'daily' merotasi log per hari & membuang yang lebih tua dari LOG_DAILY_DAYS.
# Dengan 'single' (setelan lama), laravel.log tumbuh tanpa batas -- di project
# ini sempat menembus 28.000 baris dan tidak pernah dibersihkan.
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
# 'debug' mencatat terlalu banyak detail internal di produksi.
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_bk_kartika
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@domain-sekolah-anda.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ===== FONNTE (WhatsApp) -- gunakan token BARU, bukan token yang dipakai lokal
FONNTE_TOKEN=

# ===== PEMELIHARAAN SISTEM (ditambahkan hasil audit) =====
# Nomor WA pengelola sistem (Anda / petugas TU). Dipakai command
# `sistem:cek-kesehatan` untuk mengabari KALAU ADA MASALAH -- mis. cron mati,
# backup gagal, atau APP_DEBUG tidak sengaja menyala. Kalau dikosongkan,
# laporannya hanya tercetak di log, tidak dikirim ke mana pun.
# Format: 6281234567890
ADMIN_WA_NOTIFIKASI=

# Berapa hari file backup database disimpan sebelum dihapus otomatis.
BACKUP_SIMPAN_HARI=14

# Isi HANYA kalau `php artisan backup:database` gagal dengan pesan
# "mysqldump: command not found". Di cPanel biasanya /usr/bin/mysqldump
# MYSQLDUMP_PATH=

# ===== FIREBASE (FCM - Push Notification)
FIREBASE_CREDENTIALS=storage/app/firebase/firebase-service-account.json

# Config Web App Firebase (memang didesain publik oleh Google)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=
